meta {
  name: Create boleto
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/boleto
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "externalId": "{{newId}}",
    "amount": 128000,
    "due": "2026-12-31",
    "payer": {
      "name": "Morty Smith",
      "taxId": "98765432100"
    },
    "description": "Interdimensional science tuition",
    "tags": [
      "smith-family",
      "school"
    ]
  }
}
